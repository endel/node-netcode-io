{
  "name": "netcode-io",
  "version": "0.0.1",
  "description": "WebSocket and WebTransport server for Node.js, powered by quic-zig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endel/node-netcode-io.git"
  },
