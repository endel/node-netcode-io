{
  "name": "netcode-io",
  "version": "0.0.4",
  "description": "WebSocket and WebTransport server for Node.js, powered by quic-zig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endel/node-netcode-io.git"
  },
  "homepage": "https://github.com/endel/node-netcode-io#readme",
  "bugs": {
    "url": "https://github.com/endel/node-netcode-io/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "optionalDependencies": {
    "@netcode-io/darwin-arm64": "0.0.4",
    "@netcode-io/darwin-x64": "0.0.4",
    "@netcode-io/linux-arm64": "0.0.4",
    "@netcode-io/linux-arm64-musl": "0.0.4",
    "@netcode-io/linux-x64": "0.0.4",
    "@netcode-io/linux-x64-musl": "0.0.4",
    "@netcode-io/win32-arm64": "0.0.4",
    "@netcode-io/win32-x64": "0.0.4"
  },
  "scripts": {
    "build": "zig build -Doptimize=ReleaseFast",
    "test": "zig build test && node --test --test-timeout=20000 test/*.test.js && NETCODE_IO_THREAD=quic node --test --test-timeout=20000 test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "webtransport",
    "websocket",
    "quic",
    "http3",
    "zig"
  ],
  "license": "MIT"
}
